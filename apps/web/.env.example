# Public origin used for canonical URLs, sitemap, robots and Open Graph tags.
# TODO(launch): confirm the production domain with the client. The default in
# src/app/layout.tsx is inferred from photos@newacemedia.com.
NEXT_PUBLIC_SITE_URL=https://www.newacemedia.com

# --- Inquiry delivery -------------------------------------------------------
# Without RESEND_API_KEY the POST /api/inquiries handler logs the submission
# instead of emailing it, so the flow stays testable in development.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=photos@newacemedia.com
INQUIRY_FROM_EMAIL=Newace Website <website@newacemedia.com>
